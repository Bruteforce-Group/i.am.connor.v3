{
  "name": "connor-core",
  "version": "1.0.0",
  "description": "Local AI assistant service with voice, computer use, and memory",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "node dist/index.js --cli",
    "voice": "node dist/index.js --voice",
    "text": "node dist/index.js --text",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.11.0",
    "openai": "^7.30.1",
    "ws": "^8.14.0",
    "playwright": "^1.40.0",
    "axios": "^1.6.0",
    "dotenv": "^18.0.6",
    "zod": "^4.6.5",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.10.0",
    "@types/ws": "^8.5.0",
    "@types/uuid": "^11.0.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "eslint": "^10.12.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1"
  }

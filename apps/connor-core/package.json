    "text": "node dist/index.js --text",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "express": "^4.18.0",
    "pg": "^8.11.0",
    "openai": "^4.20.0",
    "ws": "^8.14.0",

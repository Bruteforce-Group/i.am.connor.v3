{
  "name": "connor-core",
  "version": "1.0.0",
  "description": "Local AI assistant service with voice, computer use, and memory",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "node dist/index.js --cli",
